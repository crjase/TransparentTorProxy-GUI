pkgname=ttp-desktop
pkgver=0.4.4
pkgrel=1
pkgdesc='Desktop controller for TransparentTorProxy'
arch=('x86_64')
depends=('transparent-tor-proxy' 'gtk3' 'webkit2gtk-4.1' 'libappindicator' 'sudo')
options=('!debug')
source=('ttp-desktop' 'io.ttp.TTPDesktop.desktop' '16x16.png' '22x22.png' '24x24.png' '32x32.png' '48x48.png' '64x64.png' '128x128.png' '256x256.png' '512x512.png' 'Inter-OFL.txt' 'JetBrainsMono-OFL.txt')

package() {
    local id=io.ttp.TTPDesktop size
    install -Dm755 "$srcdir/ttp-desktop" "$pkgdir/usr/bin/ttp-desktop"
    install -Dm644 "$srcdir/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
    for size in 16x16 22x22 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
        install -Dm644 "$srcdir/$size.png" "$pkgdir/usr/share/icons/hicolor/$size/apps/$id.png"
    done
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/Inter-OFL.txt" "$srcdir/JetBrainsMono-OFL.txt"
}
